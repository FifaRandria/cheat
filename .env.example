# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://rustine:rustine@localhost:5432/rustine?schema=public"

# --- API (apps/api) -----------------------------------------------------------
API_PORT=4000
# URL publique du frontend (redirections OAuth, CORS)
WEB_URL="http://localhost:3000"
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-moi-avec-une-longue-chaine-aleatoire"
# Dossier du contenu pédagogique (relatif à apps/api ou absolu)
CONTENT_DIR="../../content"

# OAuth GitHub (optionnel) : https://github.com/settings/developers
# Callback URL : http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Runner (apps/runner) -----------------------------------------------------
RUNNER_URL="http://localhost:4100"
RUNNER_PORT=4100
# Secret partagé entre l'API et le runner
RUNNER_TOKEN="change-moi-aussi"
# docker (par défaut, isolé) | unsafe-local (DEV UNIQUEMENT : exécute le code sans isolation)
RUNNER_MODE="docker"
RUNNER_IMAGE="node:22-alpine"
RUNNER_PYTHON_IMAGE="python:3.12-alpine"
# Interpréteur utilisé en mode unsafe-local (python, python3 ou py)
RUNNER_PYTHON_BIN="python"
RUNNER_TIMEOUT_MS=8000
RUNNER_CONCURRENCY=4

# --- Web (apps/web) -----------------------------------------------------------
# URL interne de l'API, utilisée par le proxy Next.js (/api/* -> API)
API_INTERNAL_URL="http://localhost:4000"
